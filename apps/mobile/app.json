{
  "expo": {
    "name": "Kids Guide",
    "slug": "kids-guide",
    "scheme": "kidsguide",
    "version": "0.25.1",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/opening-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kidsguide.app",
      "buildNumber": "37"
    },
    "android": {
      "package": "com.kidsguide.app",
      "versionCode": 37
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "./plugins/withStandaloneAndroid.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
